{
  "id": null,
  "uid": "story-agent-overview",
  "title": "Story Agent Production Overview",
  "tags": ["story-agent", "api", "otel"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "title": "API requests / second", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (http_route) (rate(http_server_request_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{http_route}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 } },
    { "id": 2, "title": "API 4xx / 5xx share", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(rate(http_server_request_count_total{service_name=\"story-agent-api\",http_response_status_class=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_count_total{service_name=\"story-agent-api\"}[$__rate_interval])), 0.001)", "legendFormat": "4xx share" }, { "expr": "sum(rate(http_server_request_count_total{service_name=\"story-agent-api\",http_response_status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_count_total{service_name=\"story-agent-api\"}[$__rate_interval])), 0.001)", "legendFormat": "5xx share" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 } },
    { "id": 3, "title": "Route p50 / p95 / p99 latency", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.50, sum by (le,http_route) (rate(http_server_request_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "p50 {{http_route}}" }, { "expr": "histogram_quantile(0.95, sum by (le,http_route) (rate(http_server_request_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "p95 {{http_route}}" }, { "expr": "histogram_quantile(0.99, sum by (le,http_route) (rate(http_server_request_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "p99 {{http_route}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 } },
    { "id": 4, "title": "Story generation outcomes", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (outcome) (rate(story_agent_generation_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{outcome}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 } },
    { "id": 5, "title": "Generation p95 duration", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,outcome) (rate(story_agent_generation_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "{{outcome}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 } },
    { "id": 6, "title": "Provider requests", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (provider,outcome) (rate(story_agent_llm_request_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{provider}} {{outcome}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 } },
    { "id": 7, "title": "Queue depth and oldest age", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "story_agent_queue_depth{service_name=\"story-agent-api\"}", "legendFormat": "queued" }, { "expr": "story_agent_queue_oldest_age_milliseconds{service_name=\"story-agent-api\"} / 1000", "legendFormat": "oldest seconds" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 } },
    { "id": 8, "title": "Queued processing p95", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,outcome) (rate(story_agent_queue_processing_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "{{outcome}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 } },
    { "id": 9, "title": "Active runs and Node runtime", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "story_agent_active_runs{service_name=\"story-agent-api\"}", "legendFormat": "active runs" }, { "expr": "nodejs_memory_heap_used_bytes{service_name=\"story-agent-api\"}", "legendFormat": "heap bytes" }, { "expr": "nodejs_memory_rss_bytes{service_name=\"story-agent-api\"}", "legendFormat": "rss bytes" }, { "expr": "nodejs_process_cpu_utilization_ratio{service_name=\"story-agent-api\"}", "legendFormat": "cpu ratio" }, { "expr": "nodejs_event_loop_utilization_ratio{service_name=\"story-agent-api\"}", "legendFormat": "event loop ratio" }], "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 } },
    { "id": 10, "title": "Provider request p95", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,provider,outcome) (rate(story_agent_llm_request_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "{{provider}} {{outcome}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 } },
    { "id": 11, "title": "Provider retryable failures, failover, and circuit decisions", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (decision) (rate(story_agent_provider_decision_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{decision}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 } },
    { "id": 12, "title": "MongoDB latency, failures, and connection", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,db_collection_name,db_operation_name) (rate(mongodb_operation_duration_milliseconds_bucket{service_name=\"story-agent-api\"}[$__rate_interval])))", "legendFormat": "{{db_collection_name}} {{db_operation_name}} p95" }, { "expr": "sum by (db_collection_name,db_operation_name) (rate(mongodb_operation_failure_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{db_collection_name}} {{db_operation_name}} errors" }, { "expr": "mongodb_connection_state{service_name=\"story-agent-api\"}", "legendFormat": "connection state" }], "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 } },
    { "id": 13, "title": "Queue events and admission decisions", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (event) (rate(story_agent_queue_event_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "queue {{event}}" }, { "expr": "sum by (decision) (rate(story_agent_admission_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "admission {{decision}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 } },
    { "id": 14, "title": "Validation failures and repair", "type": "timeseries", "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (event) (rate(story_agent_validation_count_total{service_name=\"story-agent-api\"}[$__rate_interval]))", "legendFormat": "{{event}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 } },
    { "id": 15, "title": "API logs (requires approved Loki ingestion)", "type": "logs", "datasource": { "type": "loki", "uid": "loki" }, "targets": [{ "expr": "{service=\"api\"}" }], "gridPos": { "h": 10, "w": 24, "x": 0, "y": 64 } }
  ]
}
