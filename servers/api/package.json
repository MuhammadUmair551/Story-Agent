{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test integrations/**/tests/*.test.ts features/health/tests/*.test.ts features/story-agent/tests/*.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/mongodb.test.ts tests/shutdown.test.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
