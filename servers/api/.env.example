NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Exact trusted browser origins, separated by commas. Single-origin values still work.
# Add each approved deployment URL explicitly; do not use wildcards.
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Optional OpenTelemetry OTLP/HTTP export (leave empty for terminal-only operation)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=story-agent-api

MONGODB_URI=

# Required with MongoDB: canonical web origin must also appear in WEB_ORIGIN.
# Production requires HTTPS and uses Secure, HttpOnly, first-party session cookies.
AUTH_PUBLIC_ORIGIN=http://localhost:3000

LLM_PROVIDERS=groq,gemini,ollama

# Primary: Groq
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-20b

# Gemini
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash

OTEL_EXPORTER_OTLP_PROTOCOL=

# Ollama Cloud
LLM_OLLAMA_BASE_URL=https://ollama.com/v1
LLM_OLLAMA_API_KEY=
LLM_OLLAMA_MODEL=gemma4:31b:cloud

# Routing
LLM_PROFILE_FAST=groq,gemini,ollama
LLM_PROFILE_GENERATE=groq,gemini,ollama
LLM_PROFILE_TOOLS=groq,gemini,ollama

LLM_COOLDOWN_MS=30000
